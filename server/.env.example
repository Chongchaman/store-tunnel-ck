# Google Sheets ID (copy from Sheet URL)
SPREADSHEET_ID=your_spreadsheet_id_here

# Service Account JSON (วาง JSON ทั้งก้อนใน single line)
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# Port (Cloud Run จะกำหนดให้อัตโนมัติ)
PORT=8080
